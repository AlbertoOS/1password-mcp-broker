{
  "name": "1password-mcp-broker",
  "version": "0.0.0-private",
  "private": true,
  "description": "Deny-by-default 1Password MCP credential broker prototype",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "package:check": "node scripts/verify-package.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
